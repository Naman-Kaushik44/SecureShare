{
  "tests": [
    {
      "test": "T1 Wireshark-style capture: plaintext baseline",
      "expected": "file contents readable on the wire",
      "observed": "marker found in 28755 captured bytes: True",
      "passed": true
    },
    {
      "test": "T2 capture of SecureShare traffic",
      "expected": "only ciphertext visible; no plaintext on the wire",
      "observed": "plaintext found in 82156 captured bytes: False; round-trip verdict: Verified",
      "passed": true
    },
    {
      "test": "T2b server storage at rest",
      "expected": "stored blob is ciphertext",
      "observed": "plaintext marker in stored file: False",
      "passed": true
    },
    {
      "test": "T3 random 1-bit ciphertext flips (AES-GCM)",
      "expected": "50/50 flagged 'File Tampered'",
      "observed": "50/50 flagged (0 by SHA-256 mismatch, 50 by cipher auth/padding failure)",
      "passed": true
    },
    {
      "test": "T3 random 1-bit ciphertext flips (AES-CBC)",
      "expected": "50/50 flagged 'File Tampered'",
      "observed": "50/50 flagged (50 by SHA-256 mismatch, 0 by cipher auth/padding failure)",
      "passed": true
    },
    {
      "test": "T3b same bit flips against plaintext baseline",
      "expected": "tampering goes unnoticed (0% detection)",
      "observed": "50/50 downloads silently corrupted, 0 alerts raised",
      "passed": true
    },
    {
      "test": "T4 modified hash record in database",
      "expected": "'File Tampered' (Original SHA-256 != Received SHA-256)",
      "observed": "File Tampered - Original SHA-256 != Received SHA-256; signature_ok=False",
      "passed": true
    },
    {
      "test": "T5 unauthorized access",
      "expected": "no token -> 401; forged token -> 401; other user -> 403; bad password -> 401",
      "observed": "401; 401; 403; 401",
      "passed": true
    },
    {
      "test": "T5b brute-force lockout",
      "expected": "6th attempt throttled (429)",
      "observed": "status codes [401, 401, 401, 401, 401, 429]",
      "passed": true
    },
    {
      "test": "T6a upload signed with unregistered key",
      "expected": "server rejects (400 invalid digital signature)",
      "observed": "400 {'error': 'invalid digital signature'}",
      "passed": true
    },
    {
      "test": "T6b signature swapped for attacker's at rest",
      "expected": "recipient rejects: sender authenticity fails",
      "observed": "Signature Invalid (hash_ok=True, sig_ok=False)",
      "passed": true
    },
    {
      "test": "T6c unverified file is never written to disk",
      "expected": "no output file for forged file",
      "observed": "saved_to present: False",
      "passed": true
    }
  ],
